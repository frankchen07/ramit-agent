# Required
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql://ramit:ramit@localhost:5432/ramit
CHAT_PROVIDER=anthropic
CHAT_MODEL=claude-sonnet-4-6-20250514

# Optional: cheaper model/provider for conversation summarization (defaults to CHAT_MODEL/CHAT_PROVIDER)
MEMORY_PROVIDER=openrouter
MEMORY_MODEL=anthropic/claude-haiku-4.5

# Provider key — set the one matching CHAT_PROVIDER above
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=  # required if CHAT_PROVIDER or MEMORY_PROVIDER is openrouter
# OPENAI_API_KEY=

# Optional
# Comma-separated Telegram user IDs that bypass the invite check
ADMIN_TELEGRAM_USER_IDS=

# Optional — knowledge pipeline (default: knowledge/output/ramit-sethi)
# KNOWLEDGE_OUTPUT_DIR=
# Optional — provider for the knowledge pipeline (default: anthropic)
# LLM_PROVIDER=
